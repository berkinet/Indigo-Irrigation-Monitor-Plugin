<?xml version="1.0"?>
<Devices>
    <Device type="custom" id="irrigationMonitor">
        <Name>Irrigation monitor</Name>
        <ConfigUI>
            <Field id="rainMachineDevices" type="list">
                <Label>RainMachine controllers:</Label>
                <Description>Select the Indigo RainMachine controller devices to monitor.</Description>
                <List class="self" method="availableRainMachineDevices" dynamicReload="true"/>
            </Field>
            <Field id="linkTapDevices" type="list">
                <Label>LinkTap zones:</Label>
                <Description>Select each Indigo MQTT Shims LinkTap zone device to monitor.</Description>
                <List class="self" method="availableLinkTapDevices" dynamicReload="true"/>
            </Field>
        </ConfigUI>
        <States>
            <State id="onOffState" readonly="true">
                <ValueType boolType="OnOff">Boolean</ValueType>
                <TriggerLabel>Any zone watering</TriggerLabel>
                <ControlPageLabel>Any zone watering</ControlPageLabel>
            </State>
            <State id="activeZones" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Active zones</TriggerLabel>
                <ControlPageLabel>Active zones</ControlPageLabel>
            </State>
            <State id="activeCount" readonly="true">
                <ValueType>Number</ValueType>
                <TriggerLabel>Active zone count</TriggerLabel>
                <ControlPageLabel>Active zone count</ControlPageLabel>
            </State>
            <State id="activeSince" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Active since</TriggerLabel>
                <ControlPageLabel>Active since</ControlPageLabel>
            </State>
            <State id="remainingMinutes" readonly="true">
                <ValueType>Number</ValueType>
                <TriggerLabel>Remaining minutes</TriggerLabel>
                <ControlPageLabel>Remaining minutes</ControlPageLabel>
            </State>
            <State id="lastEvent" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Last irrigation event</TriggerLabel>
                <ControlPageLabel>Last irrigation event</ControlPageLabel>
            </State>
            <State id="recentRun1" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 1</TriggerLabel>
                <ControlPageLabel>Recent run 1</ControlPageLabel>
            </State>
            <State id="recentRun2" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 2</TriggerLabel>
                <ControlPageLabel>Recent run 2</ControlPageLabel>
            </State>
            <State id="recentRun3" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 3</TriggerLabel>
                <ControlPageLabel>Recent run 3</ControlPageLabel>
            </State>
            <State id="recentRun4" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 4</TriggerLabel>
                <ControlPageLabel>Recent run 4</ControlPageLabel>
            </State>
            <State id="recentRun5" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 5</TriggerLabel>
                <ControlPageLabel>Recent run 5</ControlPageLabel>
            </State>
            <State id="recentRun6" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 6</TriggerLabel>
                <ControlPageLabel>Recent run 6</ControlPageLabel>
            </State>
            <State id="recentRun7" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 7</TriggerLabel>
                <ControlPageLabel>Recent run 7</ControlPageLabel>
            </State>
            <State id="recentRun8" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 8</TriggerLabel>
                <ControlPageLabel>Recent run 8</ControlPageLabel>
            </State>
            <State id="recentRun9" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 9</TriggerLabel>
                <ControlPageLabel>Recent run 9</ControlPageLabel>
            </State>
            <State id="recentRun10" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>Recent run 10</TriggerLabel>
                <ControlPageLabel>Recent run 10</ControlPageLabel>
            </State>
            <State id="historyFile" readonly="true">
                <ValueType>String</ValueType>
                <TriggerLabel>History file</TriggerLabel>
                <ControlPageLabel>History file</ControlPageLabel>
            </State>
        </States>
        <UiDisplayStateId>onOffState</UiDisplayStateId>
    </Device>
</Devices>
